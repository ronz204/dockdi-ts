{
  "compilerOptions": {
    // Environment & Target
    "lib": ["ES2022"],
    "target": "ES2022",
    "module": "Preserve",
    "moduleDetection": "force",
    "allowJs": false,

    // Bundler mode & Emit
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Declarations checking (guarantees compatibility with oxc/bunup)
    "declaration": true,
    "isolatedDeclarations": true,

    // Best practices & strictness
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noPropertyAccessFromIndexSignature": false,

    // Path aliases
    "paths": {
      "@source/*": ["./source/*"],
      "@testing/*": ["./testing/*"]
    }
  },
  "include": ["source", "testing"],
  "exclude": ["dist", "node_modules"]
}
